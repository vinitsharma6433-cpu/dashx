# Copy to factory.env (git-ignored) and edit. Only override what you need; see CONFIG.md.
DAILY_REEL_LIMIT=5
AUTO_GENERATE=true
AUTO_QC=true
AUTO_REPAIR=true
AUTO_THUMBNAIL=true
AUTO_SEO=true
AUTO_UPLOAD=false
SOURCE=auto
RUN_TIME=09:00

# YouTube (optional). These are PATHS to files, never the secrets themselves.
# YOUTUBE_CLIENT_SECRET_FILE=C:\Users\you\secrets\dashx_client_secret.json
# YOUTUBE_TOKEN_FILE=C:\Users\you\secrets\dashx_youtube_token.json
